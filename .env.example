# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
ADMIN_CHANNEL_ID=C...

# Postgres — local governance (admins, approvals, audit, checkpoints)
# Semantic meanings live in semantic_layer/ YAML — not in this DB.
DATABASE_URL=postgresql://test:test@localhost:5432/data_request_agent

# Business / tabular data the agent queries
# MVP: dummy Postgres warehouse (e.g. Render). Post-MVP: BigQuery via BigQueryStore.
# BUSINESS_DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB_NAME?sslmode=require
# Alias used at run time (Stage 6 may point at a read-only Postgres role):
# READONLY_DATABASE_URL=

# LLM / agent
OPENAI_API_KEY=

# Optional tunables (override config.py defaults)
# ROW_CAP=10000
# STATEMENT_TIMEOUT_MS=30000
# APPROVAL_EXPIRY_HOURS=48
